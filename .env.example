# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Default sender. Must use a domain verified in Resend.
# Format: "Display Name <address@your-domain.com>"
RESEND_FROM=Congrem <noreply@your-domain.com>

# Optional shared secret. If set, requests must send
# Authorization: Bearer <EMAIL_API_KEY>. Leave unset to disable auth (dev only).
EMAIL_API_KEY=

# Secret of Supabase Auth's Send Email hook (Authentication → Hooks in the
# dashboard). Enables POST /hooks/send-email, which sends the sign-in codes.
# Format: v1,whsec_<base64>
SEND_EMAIL_HOOK_SECRET=

# Public URL of this service. Emails link to the images in static/ through it,
# so it must be reachable from the open internet.
PUBLIC_URL=https://email.example.com

# Port the email API listens on (default 3001).
PORT=3001
