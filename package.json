    "luxon": "^3.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.7",
    "resend": "^4.0.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.7",
    "@types/luxon": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
